extends /index.pug
block content
  img(class="background " src="/assets/images/bg/bg.png" alt="background") 
  include /widgets/drones_page_hero/drones_page_hero.pug
  section.drones_theory_practice 
    div 
      h3 Теорія 
      p У сучасній мультимедійній аудиторії: зрозуміло, структуровано, з реальними кейсами.
    div 
      h3 Практика
      p На відкритій безпечній території: реальні сценарії, тренери з бойовим досвідом, робота з FPV, моделювання бойових умов.
  section.drones_benefits 
    img.drones_benefits__bg(src="/assets/images/drones/drones_bg.jpg")
    img.drones_benefits__bg_mob(src="/assets/images/drones/drones_bg_mob.jpg")
    .drones_benefits__wrapper 
      .drones_benefits__left З нами ти отримаєш:
      .drones_benefits__right
        .drones_benefits__item 
          svg
            use(href="/assets/icons.svg#Check")
          span Навички керування дроном в екстремальних ситуаціях
        .drones_benefits__item 
          svg
            use(href="/assets/icons.svg#Check")
          span Розуміння тактики й безпеки
        .drones_benefits__item 
          svg
            use(href="/assets/icons.svg#Check")
          span Досвід роботи з різними типами дронів та камер

  section.drones_template.card_wrapper
    .drones_template__wrapper 
      .drones_template__left 
        h2 Для цивільних
        img(src="/assets/images/drones/drones_1.jpg" alt="drones")
      .drones_template__right
        h3 Курс пілота FPV-дронів
        h4 Комплексна підготовка операторів FPV-дронів для спортивного та професійного застосування
        span Для кого курс:
        ul 
          li Цивільні ентузіасти та хобісти
          li Студенти технічних спеціальностей
          li Люди, які хочуть опанувати сучасні дронові технології
          li Майбутні спортсмени FPV та оператори відеозйомки з дронів
        span Оснащення:
        ul 
          li Симулятори на ПК для тренувань
          li Готові FPV-дрони для практики
          li Зали з безпечними маршрутами та перешкодами
          li Просторі майданчики для польотів на свіжому повітрі
          li Інструктори з досвідом у FPV, електроніці та відеозйомці
        span Хочеш служити — допомагай ефективно.
        p Після завершення цього курсу є можливість продовжити навчання в окремій програмі для військових, де опановуються бойові сценарії, робота з “Кропивою”, взаємодія з підрозділами, та інші прикладні навички.
        span Опануй сучасну технологію — відчуй політ на власні очі.
        span FPV — це спорт, техніка, творчість і майбутнє.
        .drones_template__btn 
          button.button_pa(data-btn="binotel-open")
            svg.header__cta-icon
              use(href="/assets/icons.svg#Calendar")
            span ЗАПИСАТИСЯ НА КУРС
          .info(id="open-pop-up-cls")
            svg
              use(href="/assets/icons.svg#Info")
            span Переглянути програму курсу
  
  section.drones_template.card_wrapper
    .drones_template__wrapper 
      .drones_template__left 
        h2 Для військових
        img(src="/assets/images/drones/drones_2.jpg" alt="drones")
      .drones_template__right
        h3 Курс бойового пілота FPV-дронів
        h4 Професійна підготовка операторів ударних FPV-квадрокоптерів для виконання бойових завдань
        span Для кого курс:
        ul 
          li Військовослужбовці ЗСУ
          li Добровольчі формування
          li Спеціальні підрозділи
          li Інструктори для підготовки нових пілотів
        span Оснащення:
        ul 
          li Cучасні бойові FPV-дрони
          li Високоточні комп’ютерні симулятори
          li Полігони, що імітують реальні бойові умови
          li Навчання ведеться досвідченими інструкторами
          
        .drones_template__btn 
          button.button_pa(data-btn="binotel-open")
            svg.header__cta-icon
              use(href="/assets/icons.svg#Calendar")
            span ЗАПИСАТИСЯ НА КУРС
          .info(id="open-pop-up-cls")
            svg
              use(href="/assets/icons.svg#Info")
            span Переглянути програму курсу

  section.drones_videos.card_wrapper
    .drones_videos__title.title Де проходить навчання?
    .drones_videos__wrapper 
      .drones_videos__left
        video(autoplay loop playsinline muted preload="metadata")
          source(src="/public_static/videos/drones_1-720.mp4")
        
      .drones_videos__right
        video(autoplay loop playsinline muted preload="metadata")
          source(src="/public_static/videos/drones_2-720.mp4")
        

  section.drones_gallery 
    .drones_gallery__wrapper.card_wrapper
      .drones_gallery__title.title Галерея
      .navigation
        svg.drones_gallery__nav.drones_gallery__nav--prev
          use(href="/assets/icons.svg#Big_arrow_left")
        svg.drones_gallery__nav.drones_gallery__nav--next
          use(href="/assets/icons.svg#Big_arrow_right")
      .drones_gallery__swiper_wrapper
        .swiper 
          .swiper-wrapper
            .swiper-slide.gallery_slide
              img(src="/public_static/img/drones/drones_3.jpg" alt="relax zone")
            .swiper-slide.gallery_slide
              img(src="/public_static/img/drones/drones_4.jpg" alt="relax zone")
            .swiper-slide.gallery_slide
              img(src="/public_static/img/drones/drones_3.jpg" alt="relax zone")
            .swiper-slide.gallery_slide
              img(src="/public_static/img/drones/drones_4.jpg" alt="relax zone")

  section.drones_slogan 
    img(src="/assets/images/drones/drone_image.png" alt="drone")
    .drones_slogan__wrapper 
      div Навчайся 
        span.word_1 Навчайся
      div літати 
        span.word_2 літати
      div Контролюй
        span.word_3 Контролюй
      div повітря 
        span.word_4 повітря


  include /widgets/show_prices/show_prices.pug